# pawelium — production environment
# =========================================================================
# All values here are PUBLIC (NEXT_PUBLIC_*) — they are inlined into the
# client bundle at build time. Do not put secrets in this file.
#
# Next.js loads this automatically during `next build` / `next start` when
# NODE_ENV=production. On Netlify/Vercel you may instead set these in the
# dashboard (dashboard values override this file).
# =========================================================================

# ─── Site identity ───────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="pawelium"
NEXT_PUBLIC_SITE_URL="https://pawelium.fyi"

# ─── WhatsApp (with country code) ────────────────────────────────────────
# Non-digits are stripped before building wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER="+33641325328"

# Dedicated number for the "Devenir partenaire" programme.
# Leave empty to fall back to NEXT_PUBLIC_WHATSAPP_NUMBER.
NEXT_PUBLIC_PARTNER_WHATSAPP_NUMBER="33641325328"

# ─── Contact ─────────────────────────────────────────────────────────────
# Shown on /contact and /mentions-legales. Point at a real mailbox.
NEXT_PUBLIC_CONTACT_EMAIL="contact@pawelium.fyi"

# ─── Legal (France) ──────────────────────────────────────────────────────
# SIREN or SIRET of the site editor. Required on /mentions-legales for a
# commercial activity. Until set, the page shows "immatriculation en cours".
NEXT_PUBLIC_LEGAL_SIREN=""

# ─── Search Console / analytics ──────────────────────────────────────────
# Site is verified via the /google8ba7d4ac32edda16.html file in /public.
# Optional: paste the GSC "HTML tag" token here to also verify via <meta>.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Build ───────────────────────────────────────────────────────────────
NEXT_TELEMETRY_DISABLED="1"
