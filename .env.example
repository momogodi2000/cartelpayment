# Pawelium — environment template
# Copy to `.env` (local) and fill in. NEVER commit real values.
# Production values are configured in the Netlify UI (Site settings → Environment variables).
# ==============================================================================

# ─── Site identity ─────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_SITE_NAME="Pawelium"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@pawelium.fyi"   # also receives SUPER_ADMIN payment alerts

# ─── WhatsApp assistance channel (not a checkout channel) ─────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_PARTNER_WHATSAPP_NUMBER=""

# ─── Business identity (legal pages) ──────────────────────────────────────────
NEXT_PUBLIC_LEGAL_SIREN=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Database ─────────────────────────────────────────────────────────────────
# Local: SQLite (prisma/sqlite/dev.db). Production: Neon PostgreSQL.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# Neon: DATABASE_URL = pooled connection (…-pooler…/db?sslmode=require),
#       DIRECT_DATABASE_URL = direct connection used by `prisma migrate deploy`.
DIRECT_DATABASE_URL=""

# ─── GeniusPay (payment orchestration — internal, never shown to customers) ───
# Docs: https://geniuspay.ci/docs/api
# Keys from the GeniusPay dashboard → Settings → API. Sandbox keys and live keys are
# validated against GENIUSPAY_ENVIRONMENT at startup (mixing them is refused).
GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_ENVIRONMENT="sandbox"          # "sandbox" | "production"
GENIUSPAY_API_KEY=""                     # X-API-Key (pk_sandbox_… / pk_live_…)
GENIUSPAY_API_SECRET=""                  # X-API-Secret (server only)
GENIUSPAY_WEBHOOK_SECRET=""              # whsec_… returned when the webhook is created
GENIUSPAY_AMOUNT_UNIT="major"            # EUR amount sent as 1.00 (major). XOF is always sent as a whole-franc integer.
GENIUSPAY_PAYMENT_METHOD="card"          # customers only ever see "Credit/Debit Card"
GENIUSPAY_TIMEOUT_MS=10000
# Gateway order / enablement is managed in /admin/payments (not via env).

# ─── EUR → XOF conversion (card checkout while Paystack is the active gateway) ─
# The marketplace stays in EUR. Paystack charges whole-franc XOF, so the server converts and
# stores the quote (rate, source, timestamp) on every Payment. No hardcoded fallback rate:
# if the source is unreachable, card payment is blocked with a clear message.
# The default source is ExchangeRate-API's open endpoint (the ECB/Frankfurter feed does not
# publish XOF). Its terms require attribution; use a paid/own source for heavy traffic.
FX_RATE_API_URL="https://open.er-api.com/v6/latest/EUR"   # JSON with rates.XOF
FX_RATE_TTL_SECONDS=300                  # how long a fetched rate is reused across checkouts
FX_QUOTE_MAX_AGE_SECONDS=1800            # a retry keeps its original quote up to this age
FX_MARKUP_BPS=0                          # optional spread in basis points (disclosed rate includes it)

# Optional, tests only: real SANDBOX credentials for `npm run test:sandbox`.
GENIUSPAY_SANDBOX_API_KEY=""
GENIUSPAY_SANDBOX_API_SECRET=""
GENIUSPAY_SANDBOX_BASE_URL=""

# ─── Inventory ────────────────────────────────────────────────────────────────
HOLD_MINUTES=30

# ─── Security ─────────────────────────────────────────────────────────────────
# Required in production (startup fails if left at the development fallback):
ENCRYPTION_KEY=""      # openssl rand -hex 32  (AES-256-GCM: TOTP secrets, signed links)
CRON_SECRET=""         # openssl rand -hex 32  (Netlify scheduled functions → /api/internal/cron/*)
ADMIN_BOOTSTRAP_PASSWORD=""   # optional; `npm run admin:credentials` generates one if empty

# ─── Transactional email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Pawelium <contact@pawelium.fyi>"

# ─── Media storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
