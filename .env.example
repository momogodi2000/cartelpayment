# Pawelium 2.0 — Environment Configuration
# ==============================================================================

# ─── Environment & Site Identity ──────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_SITE_NAME="Pawelium"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL="contact@pawelium.fyi"

# ─── WhatsApp Concierge Channels ──────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER="+33641325328"
NEXT_PUBLIC_PARTNER_WHATSAPP_NUMBER="33641325328"

# ─── Verification & Business Identity (filled via settings/legal) ─────────────
NEXT_PUBLIC_LEGAL_SIREN=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ─── Database Configuration (Dual-Provider: SQLite or PostgreSQL) ─────────────
# Set DATABASE_PROVIDER to "sqlite" (default local) or "postgresql" (Neon)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:../sqlite/dev.db"
# DIRECT_DATABASE_URL is used by Neon PostgreSQL for direct migrations
DIRECT_DATABASE_URL=""

# ─── GeniusPay Merchant API ───────────────────────────────────────────────────
# Official documentation: https://geniuspay.ci/docs/api
GENIUSPAY_BASE_URL="https://geniuspay.ci/api/v1/merchant"
GENIUSPAY_ENVIRONMENT="sandbox" # "sandbox" or "production"
GENIUSPAY_API_KEY="pk_sandbox_sample_key"
GENIUSPAY_API_SECRET="sk_sample_secret"
GENIUSPAY_WEBHOOK_SECRET="whsec_sample_secret"
GENIUSPAY_AMOUNT_UNIT="major" # "major" (e.g. 1500.00 for EUR) or "minor" (150000)
GENIUSPAY_PAYMENT_METHOD="card"

# ─── Inventory & Checkout Rules ───────────────────────────────────────────────
HOLD_MINUTES=30

# ─── Security & Administration ────────────────────────────────────────────────
# 32-byte hex key for AES-256-GCM TOTP secret encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret for internal cron requests (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="sample_cron_secret_change_me_in_production"
# Admin bootstrap default password (used by npm run admin:bootstrap if not prompted)
ADMIN_BOOTSTRAP_PASSWORD=""

# ─── Transactional Email (Resend REST) ─────────────────────────────────────────
RESEND_API_KEY="re_sample_resend_api_key"
EMAIL_FROM="Pawelium European Concierge <contact@pawelium.fyi>"

# ─── Media Storage (Cloudinary) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
