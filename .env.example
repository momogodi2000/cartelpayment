# pawelium — Environment Variables Template
# =========================================
# Copy this file to .env and fill in the values

# ─── Site Identity ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME="pawelium"
NEXT_PUBLIC_SITE_URL="https://pawelium.fyi"

# ─── WhatsApp Contact (digits only, including country code) ──────────────
# Example: "33600000000" for France +33 6 00 00 00 00
NEXT_PUBLIC_WHATSAPP_NUMBER="33600000000"

# Optional: dedicated number for the "Devenir partenaire" programme.
# Falls back to NEXT_PUBLIC_WHATSAPP_NUMBER when unset.
NEXT_PUBLIC_PARTNER_WHATSAPP_NUMBER=""

# ─── Contact Email ────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL="contact@pawelium.fyi"
