{
    "name": "pawelium",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build --webpack",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "lint": "eslint",
        "i18n:check": "tsx scripts/i18n-check.ts && tsx scripts/i18n-hardcoded.ts",
        "test": "vitest run",
        "test:i18n": "tsx scripts/i18n-check.ts",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:integration:pg": "DATABASE_PROVIDER=postgresql vitest run tests/integration",
        "test:sandbox": "vitest run tests/sandbox",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "db:generate": "tsx scripts/db.ts generate",
        "db:migrate:dev": "tsx scripts/db.ts migrate:dev",
        "db:migrate:deploy": "tsx scripts/db.ts migrate:deploy",
        "db:seed": "tsx scripts/db.ts seed",
        "db:reset": "tsx scripts/db.ts reset",
        "db:studio": "tsx scripts/db.ts studio",
        "admin:bootstrap": "tsx scripts/generate-super-admin-credentials.ts",
        "cron:run": "tsx scripts/cron-runner.ts",
        "icons:generate": "node scripts/generate-app-icons.js",
        "admin:credentials": "tsx scripts/generate-super-admin-credentials.ts",
        "db:purge-fabricated": "tsx scripts/purge-fabricated-records.ts"
    },
    "overrides": {
        "effect": "^3.21.2",
        "postcss": "^8.5.15"
    },
    "dependencies": {
        "@hookform/resolvers": "^7.0.5",
        "@prisma/client": "^6.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "class-variance-authority": "^0.7.1",
        "cloudinary": "^2.11.0",
        "clsx": "^2.1.1",
        "dotenv": "^18.0.10",
        "framer-motion": "^12.39.0",
        "lucide-react": "^1.16.0",
        "next": "^16.2.6",
        "next-intl": "^4.14.1",
        "qrcode": "^1.5.4",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.91.0",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@netlify/functions": "^6.1.1",
        "@netlify/plugin-nextjs": "^5.16.6",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/postcss": "^4",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^20.19.43",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "jsdom": "^29.1.1",
        "prisma": "^6.4.1",
        "tailwindcss": "^4",
        "tsx": "^4.22.3",
        "typescript": "^5.9.3",
        "vitest": "^2.1.9"
    }
}
