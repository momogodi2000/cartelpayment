// Prisma schema for Pawelium 2.0
// Database: SQLite for local testing, seamlessly adaptable to Neon PostgreSQL

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN") // SUPER_ADMIN, ADMIN, INVENTORY_MANAGER, ORDER_MANAGER, SUPPORT_AGENT
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]

  @@map("admin_users")
}

model Breeder {
  id           String    @id @default(uuid())
  name         String
  location     String
  country      String
  description  String?
  verified     Boolean   @default(false)
  rating       Float     @default(5.0)
  contactEmail String?
  animals      Animal[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("breeders")
}

model Breed {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String   // French name
  nameEn        String   // English name
  species       String   @default("dog") // dog, cat
  category      String   @default("moyen") // petit, moyen, grand
  origin        String
  temperament   String
  lifespan      String
  weight        String
  height        String
  description   String
  descriptionEn String
  image         String
  featured      Boolean  @default(false)
  animals       Animal[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("breeds")
}

model Animal {
  id                 String           @id @default(uuid())
  slug               String           @unique
  species            String           @default("dog") // dog, cat
  name               String
  breedSlug          String
  breedName          String
  breedNameEn        String
  category           String           @default("grand") // petit, moyen, grand
  sex                String           // male, femelle
  age                String
  ageMonths          Int
  dateOfBirth        String
  location           String
  country            String
  priceCents         Int              // EUR cents (e.g. 140000 = 1400.00 EUR)
  originalPriceCents Int              // Reference market price in cents (e.g. 215000 = 2150.00 EUR)
  currency           String           @default("EUR")
  status             String           @default("AVAILABLE") // AVAILABLE, HELD, SOLD, UNAVAILABLE, ARCHIVED
  pedigree           Boolean          @default(true)
  microchip          Boolean          @default(true)
  video              String?
  description        String
  descriptionEn      String
  temperament        String           @default("[]") // JSON serialized array
  temperamentEn      String           @default("[]") // JSON serialized array
  size               String           @default("grand")
  color              String
  weight             String
  fatherLineage      String?
  motherLineage      String?
  featured           Boolean          @default(false)
  seoTitle           String
  seoDescription     String

  // Concurrency hold mechanism
  holdExpiresAt      DateTime?
  heldByOrderId      String?

  // Relations
  breedRef           Breed?           @relation(fields: [breedSlug], references: [slug])
  breederId          String?
  breeder            Breeder?         @relation(fields: [breederId], references: [id])
  images             AnimalImage[]
  documents          AnimalDocument[]
  orderItems         OrderItem[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([species, status])
  @@index([breedSlug])
  @@index([status])
  @@map("animals")
}

model AnimalImage {
  id        String   @id @default(uuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([animalId])
  @@map("animal_images")
}

model AnimalDocument {
  id        String    @id @default(uuid())
  animalId  String
  animal    Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  title     String
  type      String    // VACCINATION, HEALTH_CERTIFICATE, PEDIGREE, PASSPORT
  fileUrl   String
  issuedAt  DateTime?
  verified  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([animalId])
  @@map("animal_documents")
}

model Customer {
  id         String   @id @default(uuid())
  email      String   @unique
  fullName   String
  phone      String
  country    String
  address    String?
  city       String?
  postalCode String?
  orders     Order[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("customers")
}

model Order {
  id                 String               @id @default(uuid())
  orderReference     String               @unique // e.g. PWL-2026-98124
  customerEmail      String
  customerName       String
  customerPhone      String
  deliveryCountry    String
  deliveryAddress    String
  deliveryCity       String
  deliveryPostalCode String
  deliveryNotes      String?
  
  // Authoritative server-side pricing in EUR cents
  subtotalCents      Int
  transportCents     Int
  taxCents           Int                  @default(0)
  totalCents         Int
  currency           String               @default("EUR")

  status             String               @default("PENDING_PAYMENT")
  paymentStatus      String               @default("PENDING")
  trackingToken      String               @unique // Secret token sent via email for tracking

  // Relations
  customerId         String?
  customer           Customer?            @relation(fields: [customerId], references: [id])
  items              OrderItem[]
  payments           Payment[]
  statusHistory      OrderStatusHistory[]
  tickets            SupportTicket[]
  delivery           Delivery?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@index([orderReference])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  animalId       String
  animal         Animal   @relation(fields: [animalId], references: [id])
  priceCents     Int
  animalSnapshot String   // JSON serialized animal snapshot
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([animalId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  actor     String   @default("SYSTEM") // SYSTEM or Admin User
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String         @default("GENIUSPAY") // GENIUSPAY, STRIPE
  providerPaymentId String?        // GeniusPay reference / transaction ID
  checkoutUrl       String?
  amountCents       Int
  currency          String         @default("EUR")
  status            String         @default("PENDING") // PENDING, SUCCESSFUL, FAILED, EXPIRED, REFUNDED
  paymentMethod     String         @default("card")
  rawResponse       String?        // JSON serialized response
  events            PaymentEvent[]
  refunds           Refund[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([orderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  eventType         String   // payment.success, payment.failed, etc.
  providerReference String?
  payload           String   // JSON serialized payload
  signatureVerified Boolean  @default(false)
  processedAt       DateTime @default(now())

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amountCents      Int
  reason           String
  status           String   @default("COMPLETED")
  providerRefundId String?
  createdAt        DateTime @default(now())

  @@index([paymentId])
  @@map("refunds")
}

model Delivery {
  id                    String    @id @default(uuid())
  orderId               String    @unique
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrierName           String?   @default("Pawelium Dedicated Animal Transport")
  trackingNumber        String?
  status                String    @default("PREPARING") // PREPARING, SCHEDULED, IN_TRANSIT, DELIVERED
  estimatedDeliveryDate DateTime?
  pickupDate            DateTime?
  deliveredDate         DateTime?
  notes                 String?
  updatedAt             DateTime  @updatedAt

  @@map("deliveries")
}

model GuestVerification {
  id             String    @id @default(uuid())
  email          String
  orderReference String
  otpCode        String
  token          String    @unique
  expiresAt      DateTime
  verifiedAt     DateTime?
  attempts       Int       @default(0)
  createdAt      DateTime  @default(now())

  @@index([email, orderReference])
  @@map("guest_verifications")
}

model SupportTicket {
  id              String          @id @default(uuid())
  ticketReference String          @unique // e.g. TCK-84920
  customerEmail   String
  customerName    String
  orderReference  String?
  order           Order?          @relation(fields: [orderReference], references: [orderReference])
  category        String          @default("GENERAL_INQUIRY")
  subject         String
  description     String
  priority        String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String          @default("OPEN")   // OPEN, IN_PROGRESS, WAITING_FOR_CUSTOMER, WAITING_FOR_ADMIN, RESOLVED, CLOSED
  secureToken     String          @unique
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([customerEmail])
  @@index([status])
  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType  String        // CUSTOMER or ADMIN
  senderName  String
  message     String
  attachments String?       // JSON serialized array of URLs
  createdAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

model EmailNotification {
  id             String    @id @default(uuid())
  recipientEmail String
  subject        String
  template       String
  data           String    // JSON serialized
  status         String    @default("PENDING") // PENDING, SENT, FAILED
  error          String?
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([recipientEmail])
  @@map("email_notifications")
}

model Review {
  id        String   @id @default(uuid())
  name      String
  location  String
  rating    Int      @default(5)
  content   String
  contentEn String
  breed     String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("reviews")
}

model AuditLog {
  id          String     @id @default(uuid())
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
  action      String
  entity      String
  entityId    String?
  details     String?    // JSON serialized
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@map("audit_logs")
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   // JSON serialized
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
