datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum Rarity {
  COMMON
  RARE
  EXCEPTIONAL
}

enum Size {
  SMALL
  MEDIUM
  LARGE
}

enum ParrotStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  permissions  String[] @default(["*"])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([isActive])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([email])
}

model Parrot {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  species          String
  originCountry    String            @default("")
  category         String            @default("")
  temperament      String            @default("")
  lifespan         String            @default("")
  diet             String            @default("")
  weight           String            @default("")
  talkingAbility   String            @default("")
  intelligenceLevel String           @default("")
  trainingDifficulty String          @default("")
  socialBehavior   String            @default("")
  careLevel        String            @default("")
  seoDescription   String            @default("")
  tags             String[]          @default([])
  careInstructions String            @default("")
  description      String
  shortDescription String
  age              String
  size             Size              @default(MEDIUM)
  sex              Sex               @default(UNKNOWN)
  origin           String
  rarity           Rarity            @default(COMMON)
  price            Decimal           @db.Decimal(10, 2)
  status           ParrotStatus      @default(AVAILABLE)
  behavior         String
  feeding          String
  domestication    String
  healthNotes      String
  featured         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  images           ParrotImage[]
  cartInquiries    CartInquiryItem[]

  @@index([slug])
  @@index([status])
  @@index([rarity])
  @@index([featured])
  @@index([createdAt])
  @@index([category])
}

model ParrotImage {
  id       String @id @default(uuid())
  parrotId String
  url      String
  alt      String
  order    Int    @default(0)
  parrot   Parrot @relation(fields: [parrotId], references: [id], onDelete: Cascade)

  @@index([parrotId])
}

model Category {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String

  @@index([slug])
}

model BlogPost {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  excerpt        String
  content        String
  coverImage     String
  category       String
  tags           String[]
  published      Boolean  @default(false)
  seoTitle       String
  seoDescription String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug])
  @@index([published])
  @@index([category])
  @@index([createdAt])
}

model GalleryItem {
  id       String    @id @default(uuid())
  title    String
  type     MediaType @default(IMAGE)
  url      String
  caption  String
  category String
  order    Int       @default(0)
}

model FAQ {
  id       String @id @default(uuid())
  question String
  answer   String
  order    Int    @default(0)
}

model ContactMessage {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  message         String
  parrotReference String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  avatar    String
  content   String
  rating    Int      @default(5)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model CartInquiry {
  id                  String            @id @default(uuid())
  name                String
  email               String
  phone               String
  country             String
  message             String
  preferredContact    String            // "EMAIL" | "WHATSAPP" | "PHONE"
  status              String            @default("PENDING") // "PENDING" | "COMPLETED" | "ARCHIVED"
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  items               CartInquiryItem[]

  @@index([status])
  @@index([createdAt])
}

model CartInquiryItem {
  id            String      @id @default(uuid())
  cartInquiryId String
  parrotId      String
  cartInquiry   CartInquiry @relation(fields: [cartInquiryId], references: [id], onDelete: Cascade)
  parrot        Parrot      @relation(fields: [parrotId], references: [id], onDelete: Cascade)

  @@index([cartInquiryId])
  @@index([parrotId])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([email])
}

model EmailCampaign {
  id         String                   @id @default(uuid())
  title      String
  subject    String
  body       String                   // HTML content
  status     String                   @default("DRAFT") // "DRAFT" | "SCHEDULED" | "SENT"
  createdAt  DateTime                 @default(now())
  sentAt     DateTime?
  recipients EmailCampaignRecipient[]

  @@index([status])
}

model EmailCampaignRecipient {
  id              String        @id @default(uuid())
  emailCampaignId String
  email           String
  status          String        @default("PENDING") // "PENDING" | "SENT" | "FAILED"
  sentAt          DateTime?
  errorMessage    String?
  emailCampaign   EmailCampaign @relation(fields: [emailCampaignId], references: [id], onDelete: Cascade)

  @@index([emailCampaignId])
  @@index([email])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  userId    String
  userEmail String
  action    String
  details   String
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@index([key])
}
