# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files — local/secret ones stay out; the public production + example do not
.env*
!.env.example
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite database files
*.db
*.db-journal
*.db-shm
*.db-wal

# local-only reference material (agent skills, guides)
/docs/Ai-agents-rule/

# administrator credentials & secrets
SUPER_ADMIN_CREDENTIALS.md

